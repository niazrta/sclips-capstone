 "ringkasan_metode": {
  "subjek_sinta": "LinearSVC (C=0.25) + kalibrasi sigmoid; dilatih dari SEMUA subjek SINTA tiap jurnal (bobot 1/k); fitur: TF-IDF kata (1-2) + n-gram karakter 3-5 (30.000) atas judul bersih, token nama penerbit, token kamus akar kata (judul & penerbit), token sebaran subjek jurnal lain dari penerbit yang sama.",
  "keyakinan": "Kalibrasi isotonik out-of-fold (5 fold, kelompok per judul) terhadap subjek SINTA asli; dipisah untuk penerbit yang sudah dikenal vs penerbit baru. Keyakinan = peluang label yang ditampilkan memang subjek jurnal itu.",
  "label_tampil": "Satu subjek bila keyakinan >= 70%; selain itu dua subjek teratas (peluang salah satunya benar >= 70%); cadangan: rumpun ilmu. Tidak ada label Unknown.",
  "scopus_4": "Diturunkan dari probabilitas subjek SINTA (jumlah per rumpun) -> selalu konsisten dengan predicted_subject_sinta_multilabel.",
  "scopus_27": "Model Scopus-27 v2.6 (tidak dilatih ulang), dibatasi ke bidang yang sah untuk label SINTA terpilih.",
  "tipe_penerbit": "Model & aturan v2.6; tambahan: aturan press kampus bergabung (mis. Unpadpress) dan aturan bawaan penerbit independen (COM) untuk nama tanpa kata dikenal. Jurnal tanpa nama penerbit (kosong / \"Unknown\") tidak diberi tipe & ukuran (null).",
  "multidisiplin": "Hanya bila subject_sinta dikirim dan berisi >= 4 subjek: subject_display = \"Multidisciplinary\". Dengan payload Data Mining (tanpa subject_sinta) kolom predicted_* murni hasil ML; tampilan Multidisciplinary dibentuk di view journals_public."
 },
