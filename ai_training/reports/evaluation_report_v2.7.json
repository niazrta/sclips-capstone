 "catatan": [
  "Evaluasi subjek dijalankan lewat predict_batch layanan (tanpa subject_sinta) terhadap 20% data uji yang tidak dipakai melatih model maupun kalibrator.",
  "Label benar: satu subjek -> termasuk subjek SINTA jurnal; dua subjek -> minimal satu termasuk; rumpun -> rumpun salah satu subjek SINTA.",
  "Model tipe penerbit dan Scopus-27 sama dengan v2.6; metrik keduanya tetap merujuk evaluation_report_v2.6.json.",
  "Keyakinan aturan bawaan penerbit independen (COM) = kecocokan dengan kolom tipe penerbit lama SINTA pada 513 jurnal sejenis.",
  "hasil_16768_jurnal dibuat lewat POST /classify/predict dengan payload Data Mining (tanpa subject_sinta, dengan publisher_counts).",
  "Model tipe penerbit dan Scopus-27 tidak dilatih ulang di v2.7; confusion matrix-nya tetap dari v2.6: cm_publisher_type_model_v2.6.png, cm_scopus_27_model_v2.6.png."
 ],
 "perbandingan_algoritma": {
  "tujuan": "Membandingkan Linear SVM (model v2.7) dengan Naive Bayes dan Random Forest pada fitur, bobot multi-subjek, dan data uji yang sama.",
  "fitur": "Teks v2.7 (judul bersih + token penerbit + kamus akar kata + sebaran subjek penerbit) -> TF-IDF kata 1-2 + karakter 3-5 (maks 30.000) -> MaxAbs -> L2.",
  "pengaturan": {
   "SVM": "LinearSVC C=0,25 + kalibrasi sigmoid (model v2.7)",
   "Naive Bayes": "MultinomialNB alpha=0,05 (sama dengan v2.6)",
   "Random Forest": "200 pohon, random_state=42 (sama dengan v2.6); memakai 3000 fitur TF-IDF terpenting (chi-square) karena RF dengan ~78.000 fitur butuh > 1 jam per pelatihan"
  },
  "true_label": "subjek SINTA jurnal yang cocok dengan prediksi; bila tidak ada yang cocok, subjek SINTA pertama (jurnal bisa punya >1 subjek). Scopus-4 dari jumlah probabilitas per rumpun.",
